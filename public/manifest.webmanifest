{
  "name": "Squish — Your little health buddy",
  "short_name": "Squish",
  "description": "Smarter nutrition. Happier habits.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FDF6EC",
  "theme_color": "#FDF6EC",
  "icons": [
    {
      "src": "/icon-any-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-any-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512-v3.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick snap",
      "short_name": "Snap",
      "description": "Take a photo of a meal and put your phone away. Squish logs it to check later.",
      "url": "/?snap",
      "icons": [
        {
          "src": "/icon-any-192-v2.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
