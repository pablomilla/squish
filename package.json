{
  "name": "squish",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"npm:dev:api\"",
    "start": "tsx server/index.ts",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "setup:ai": "tsx --env-file-if-exists=.env scripts/setup-ai.ts",
    "check:ai": "tsx --env-file-if-exists=.env scripts/setup-ai.ts --check",
    "bench": "tsx --env-file-if-exists=.env scripts/bench.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src server test scripts",
    "typecheck": "tsc -b",
    "test": "tsx --test test/*.test.ts",
    "build:mascot": "tsx scripts/build-mascot.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Squish \u2014 your little health buddy. AI food tracking with instant photo nutrition, habits and streaks."
}
