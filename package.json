{
  "name": "squish",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"npm:dev:api\"",
    "start": "tsx server/index.ts",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "setup:ai": "tsx --env-file-if-exists=.env scripts/setup-ai.ts",
    "check:ai": "tsx --env-file-if-exists=.env scripts/setup-ai.ts --check",
    "bench": "tsx --env-file-if-exists=.env scripts/bench.ts",
    "eval": "tsx --env-file-if-exists=.env eval/nutritionist/all.ts",
    "eval:smoke": "tsx --env-file-if-exists=.env eval/nutritionist/run.ts --smoke",
    "eval:one": "tsx --env-file-if-exists=.env eval/nutritionist/run.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src server test scripts eval",
    "typecheck": "tsc -b",
    "test": "tsx --test test/*.test.ts",
    "build:mascot": "tsx scripts/build-mascot.ts",
    "build:site-art": "tsx scripts/build-site-art.ts",
    "grant": "tsx scripts/grant.ts",
    "reset-2fa": "tsx scripts/reset-2fa.ts",
    "build:accessories": "tsx scripts/build-accessories.ts",
    "build:scenes": "tsx scripts/build-scenes.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "barcode-detector": "^3.2.2",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Squish — your little health buddy. AI food tracking with instant photo nutrition, habits and streaks."
}
