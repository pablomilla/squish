node_modules
dist
.env
.env.local
*.local
.DS_Store

# Benchmark: your meals, your results — not the repo's business
bench/photos/
bench/manifest.json
bench/results-*.json
bench/report.md

# Push subscriptions: reminder endpoints, written at runtime
.data/

# Verification screenshots, taken while working — not the repo's business
shots/

# Eval output. The scores are NOT derived — they cost real money and the
# session that produced them is thrown away, so results.jsonl, errors.jsonl
# and trajectory/ are committed. Only the bulky and the rebuildable are
# ignored: transcripts run to megabytes, and report.html regenerates from the
# results in a second.
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report.html
eval/nutritionist/cases.html

# Capacitor: the copy of the web build it drops into each platform, and the
# native build output. The projects themselves are committed; their builds are not.
ios/App/App/public/
android/app/src/main/assets/public/
ios/App/Pods/
ios/App/App.xcworkspace/
android/.gradle/
android/app/build/
android/build/
android/local.properties
