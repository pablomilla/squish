# Copy this file to `.env` (which is gitignored) and fill in your key.
# Get one at https://console.anthropic.com → Settings → API keys. The account
# needs credit on it; keys look like sk-ant-api03-...
#
# Squish reads this on the server only — it is never sent to the browser.
# `npm run dev` loads .env automatically; the server prints which mode it is in
# on startup, and You → Squish AI shows it in the app.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# SQUISH_MODEL=claude-opus-5
# PORT=8787

# Meal reminders. Run `npm run setup:push` to generate the pair, then paste it
# here. Without them the app runs fine and simply does not send nudges.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# Where the reminder subscriptions are kept. Defaults to .data/ beside the app.
# SQUISH_PUSH_STORE=.data/push-subscriptions.json
