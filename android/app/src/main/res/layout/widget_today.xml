<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quick snap widget at its usual size (SnapWidgetProvider), in the app's
  colours: the wordmark and today on the left, opening the app; the Quick
  snap button on the right. The text here is
  only for the widget picker's preview: every line is replaced with the app's
  summary, in the person's language, when the widget is drawn.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_snap_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/widget_wordmark"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_today_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1,240 kcal left"
            android:textColor="@color/widget_ink"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/widget_today_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:max="100"
            android:progress="40"
            android:progressTint="@color/widget_brand"
            android:progressBackgroundTint="@color/widget_brand_soft"
            android:progressBackgroundTintMode="src_over" />

        <TextView
            android:id="@+id/widget_today_of"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="610 of 1,850 kcal"
            android:textColor="@color/widget_ink_2"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_today_protein"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="38 of 110 g protein"
            android:textColor="@color/widget_ink_2"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_today_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12-day streak"
            android:textColor="@color/widget_brand"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_today_snap"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:background="@drawable/widget_snap_button"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:contentDescription="@string/widget_snap_label">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_snap_camera"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_today_snap_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_snap_label"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
