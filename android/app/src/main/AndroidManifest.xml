<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- squish://snap: straight into the camera, from the widget and the
                 shortcut below (src/lib/launch.ts). Not BROWSABLE: nothing on a
                 web page needs to open it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="squish" android:host="snap" />
            </intent-filter>

            <!-- Share a recipe, or a few words about a meal, from any app's
                 share sheet (MainActivity hands it on as squish://share). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- …and the link it becomes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="squish" android:host="share" />
            </intent-filter>

            <!-- Touch and hold the icon: Quick snap. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- The Quick snap widget. -->
        <receiver
            android:name=".SnapWidgetProvider"
            android:exported="false"
            android:label="@string/widget_snap_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_snap_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Photographing a meal and scanning a barcode. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Saying a meal out loud instead of typing it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Mealtime reminders. Asked for at runtime on Android 13 and later. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- So a reminder lands at the time it was set for rather than whenever
         the system next feels like waking up. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- A camera is wanted, not required: a tablet without one can still
         search, describe and dictate, and required="true" would hide Squish
         from those devices in the Play Store entirely. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
